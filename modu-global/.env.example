# Node.js 22.13 이상, node --env-file=.env server.mjs
PUBLIC_ORIGIN=http://localhost:8080
PORT=8080
# SHOP_DB_PATH=/persistent/path/shop.sqlite
SHOP_ADMIN_PASSWORD=

# 국내 카드
PAYPLE_MODE=sandbox
PAYPLE_CLIENT_KEY=
PAYPLE_CST_ID=
PAYPLE_CUST_KEY=
# 원화 고정 배송비, 무료면 0
DOMESTIC_SHIPPING_KRW=
# Y 과세 / N 비과세
PAYPLE_TAXABLE=

# 해외 PayPal Checkout
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 원화 기준 고정 해외 배송비, 무료면 0
INTERNATIONAL_SHIPPING_KRW=
# 운영자가 정한 1 USD당 원화 금액, 정수
PAYPAL_KRW_PER_USD=
# 실제 배송 가능한 ISO 3166-1 알파-2 국가 코드, 쉼표 구분. 예 US,CA
PAYPAL_SHIP_COUNTRIES=
